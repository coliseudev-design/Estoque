     );
   }
@@ -123,7 +126,11 @@ class _BranchSelectionScreenState extends State<BranchSelectionScreen> {
   }
 
   Future<void> _persistAndNavigate(BranchItem branch) async {
-    await _config.setBranch(branchId: branch.id, branchName: branch.name);
+    await _config.setBranch(
+      branchId: branch.id, 
