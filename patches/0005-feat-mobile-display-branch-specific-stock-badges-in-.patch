From b7701550c9af0f13b420cad854adfa0ce3a71cc5 Mon Sep 17 00:00:00 2001
From: Coliseu Sistemas <coliseu.dev@gmail.com>
Date: Mon, 20 Apr 2026 15:07:33 -0400
Subject: [PATCH 5/5] feat(mobile): display branch-specific stock badges in
 catalog

- Update Product model to include erpDeptoPadrao
- Update BranchItem and AppConfigService to persist erpDeptoPadrao on selection
- CatalogScreen compares product.erpDeptoPadrao with config to set isLocalBranch
- ColiseuProductCard displays green 'Sua Filial' badge for local branch products
- Fix missing AppConfigService import in CatalogScreen
---
 mobile/lib/core/config/app_config_service.dart   | 15 ++++++++++++++-
 mobile/lib/core/repositories/models/models.dart  |  6 ++++++
 .../features/auth/branch_selection_screen.dart   |  9 ++++++++-
 mobile/lib/features/catalog/catalog_screen.dart  | 12 ++++++++++++
 mobile/lib/shared/coliseu_product_card.dart      | 16 ++++++++++++++++
 5 files changed, 56 insertions(+), 2 deletions(-)

diff --git a/mobile/lib/core/config/app_config_service.dart b/mobile/lib/core/config/app_config_service.dart
index 5b6a6c9..f43158b 100644
--- a/mobile/lib/core/config/app_config_service.dart
+++ b/mobile/lib/core/config/app_config_service.dart
@@ -25,6 +25,7 @@ class AppConfigService {
   // Branch (filial) selecionada pelo vendedor após o login
   static const String _keyBranchId       = 'config_branch_id';
   static const String _keyBranchName     = 'config_branch_name';
+  static const String _keyBranchErpDeptoPadrao = 'config_branch_erp_depto_padrao';
 
   // ─────────────────────────────────────────────────────────────────────────
   // Valores padrão
@@ -105,6 +106,12 @@ class AppConfigService {
     return prefs.getString(_keyBranchName);
   }
 
+  /// Retorna o erpDeptoPadrao da filial selecionada (ou null).
+  Future<int?> getBranchErpDeptoPadrao() async {
+    final prefs = await SharedPreferences.getInstance();
+    return prefs.getInt(_keyBranchErpDeptoPadrao);
+  }
+
   /// Retorna true se uma filial já foi selecionada nesta sessão.
   Future<bool> hasBranchSelected() async {
     final id = await getBranchId();
@@ -175,10 +182,15 @@ class AppConfigService {
   }
 
   /// Persiste a filial selecionada pelo vendedor.
-  Future<void> setBranch({required String branchId, required String branchName}) async {
+  Future<void> setBranch({
+    required String branchId, 
+    required String branchName,
+    required int erpDeptoPadrao,
+  }) async {
     final prefs = await SharedPreferences.getInstance();
     await prefs.setString(_keyBranchId, branchId);
     await prefs.setString(_keyBranchName, branchName);
+    await prefs.setInt(_keyBranchErpDeptoPadrao, erpDeptoPadrao);
   }
 
   /// Limpa a filial selecionada (força re-seleção no próximo login).
@@ -186,6 +198,7 @@ class AppConfigService {
     final prefs = await SharedPreferences.getInstance();
     await prefs.remove(_keyBranchId);
     await prefs.remove(_keyBranchName);
+    await prefs.remove(_keyBranchErpDeptoPadrao);
   }
 
   /// Remove todas as configurações (volta ao padrão).
