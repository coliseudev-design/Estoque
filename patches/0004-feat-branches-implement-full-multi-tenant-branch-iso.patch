diff --git a/mobile/lib/features/auth/branch_selection_screen.dart b/mobile/lib/features/auth/branch_selection_screen.dart
new file mode 100644
index 0000000..376a142
--- /dev/null
+++ b/mobile/lib/features/auth/branch_selection_screen.dart
@@ -0,0 +1,390 @@
+/// branch_selection_screen.dart — Tela de seleção de filial pós-login.
+///
+/// Exibida condicionalmente após autenticação bem-sucedida, quando:
+///   - A empresa possui mais de uma filial configurada no Identity Server; OU
+///   - Nenhuma filial está salva no SharedPreferences.
+///
+/// Fluxo:
+///   1. Busca `GET /api/branches` no Middleware (JWT já presente no header via JwtInterceptor).
+///   2. Se só houver uma filial → seleciona automaticamente e navega para Home.
+///   3. Se houver múltiplas → exibe lista para o vendedor escolher.
+///   4. Ao confirmar → salva branchId + branchName via AppConfigService e vai para Home.
+///
+/// Rule-02: totalmente async. Sem bloqueios de UI.
+library;
+
+import 'package:flutter/material.dart';
+import 'package:dio/dio.dart';
+import '../../core/config/app_config_service.dart';
+
+// ── Model ──────────────────────────────────────────────────────────────────────
+
+class BranchItem {
+  final String id;
+  final String name;
+  final String? cnpj;
+  final int erpEmpresaId;
+  final bool isDefault;
+
+  const BranchItem({
+    required this.id,
+    required this.name,
+    this.cnpj,
+    required this.erpEmpresaId,
+    this.isDefault = false,
+  });
+
+  factory BranchItem.fromJson(Map<String, dynamic> json) {
+    return BranchItem(
+      id:           json['id']           as String,
+      name:         json['name']         as String,
+      cnpj:         json['cnpj']         as String?,
+      erpEmpresaId: (json['erpEmpresaId'] ?? 1) as int,
+      isDefault:    (json['isDefault']   ?? false) as bool,
+    );
+  }
+}
+
+// ── Screen ─────────────────────────────────────────────────────────────────────
+
+class BranchSelectionScreen extends StatefulWidget {
+  /// Rota nomeada para o Navigator.
+  static const routeName = '/branch-selection';
+
+  const BranchSelectionScreen({super.key});
+
+  @override
+  State<BranchSelectionScreen> createState() => _BranchSelectionScreenState();
+}
+
+class _BranchSelectionScreenState extends State<BranchSelectionScreen> {
+  final _config = AppConfigService();
+
+  List<BranchItem> _branches = [];
+  BranchItem?      _selected;
+  bool             _isLoading = true;
+  bool             _isConfirming = false;
+  String?          _errorMsg;
+
+  @override
+  void initState() {
+    super.initState();
+    _loadBranches();
+  }
+
+  // ── Data fetching ────────────────────────────────────────────────────────────
+
+  Future<void> _loadBranches() async {
+    setState(() { _isLoading = true; _errorMsg = null; });
+    try {
+      final serverUrl  = await _config.getServerUrl();
+      final token      = await _config.getAccessToken();
+      final dio = Dio(BaseOptions(
+        baseUrl: serverUrl,
+        headers: {
+          if (token != null && token.isNotEmpty) 'Authorization': 'Bearer $token',
+        },
+      ));
+
+      final response = await dio.get('/api/branches');
+      final list = (response.data['branches'] as List<dynamic>? ?? [])
+          .map((e) => BranchItem.fromJson(e as Map<String, dynamic>))
+          .toList();
+
+      if (!mounted) return;
+
+      // Auto-seleção: única filial → vai direto pra Home
+      if (list.length == 1) {
+        await _persistAndNavigate(list.first);
+        return;
+      }
+
+      // Pré-selecionar a filial padrão (isDefault = true)
+      final defaultBranch = list.where((b) => b.isDefault).firstOrNull ?? list.firstOrNull;
+
+      setState(() {
+        _branches = list;
+        _selected = defaultBranch;
+        _isLoading = false;
+      });
+    } on DioException catch (e) {
+      if (!mounted) return;
+      setState(() {
+        _isLoading = false;
+        _errorMsg = 'Erro ao carregar filiais: ${e.message ?? e.type.name}';
+      });
+    } catch (e) {
+      if (!mounted) return;
+      setState(() {
+        _isLoading = false;
+        _errorMsg = 'Erro inesperado: $e';
+      });
+    }
+  }
+
+  Future<void> _persistAndNavigate(BranchItem branch) async {
+    await _config.setBranch(branchId: branch.id, branchName: branch.name);
+    if (!mounted) return;
+    // Substitui a tela atual para que o Back não volte para a seleção
+    Navigator.of(context).pushReplacementNamed('/home');
+  }
+
+  Future<void> _handleConfirm() async {
+    final branch = _selected;
+    if (branch == null) return;
+
+    setState(() => _isConfirming = true);
+    try {
+      await _persistAndNavigate(branch);
+    } finally {
+      if (mounted) setState(() => _isConfirming = false);
+    }
+  }
+
+  // ── UI ──────────────────────────────────────────────────────────────────────
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final colors = theme.colorScheme;
+
+    return Scaffold(
+      backgroundColor: colors.surface,
+      body: SafeArea(
+        child: Padding(
+          padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 32),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              // ── Header ─────────────────────────────────────────────────────
+              Icon(Icons.business_outlined, size: 40, color: colors.primary),
+              const SizedBox(height: 16),
+              Text(
+                'Qual filial você vai atender?',
+                style: theme.textTheme.headlineSmall?.copyWith(
+                  fontWeight: FontWeight.w700,
+                  color: colors.onSurface,
+                ),
+              ),
+              const SizedBox(height: 8),
+              Text(
+                'Selecione a filial para iniciar sua sessão de vendas.',
+                style: theme.textTheme.bodyMedium?.copyWith(
+                  color: colors.onSurface.withOpacity(0.6),
+                ),
+              ),
+              const SizedBox(height: 32),
+
+              // ── Content ────────────────────────────────────────────────────
+              Expanded(child: _buildContent(theme, colors)),
+
+              // ── Footer: Confirmar ──────────────────────────────────────────
+              if (!_isLoading && _branches.isNotEmpty)
+                _buildConfirmButton(colors),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _buildContent(ThemeData theme, ColorScheme colors) {
+    if (_isLoading) {
+      return const Center(child: CircularProgressIndicator());
+    }
+
+    if (_errorMsg != null) {
+      return Center(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            Icon(Icons.error_outline, size: 48, color: colors.error),
+            const SizedBox(height: 12),
+            Text(_errorMsg!, textAlign: TextAlign.center,
+                style: theme.textTheme.bodyMedium?.copyWith(color: colors.error)),
+            const SizedBox(height: 20),
+            FilledButton.icon(
+              onPressed: _loadBranches,
+              icon: const Icon(Icons.refresh),
+              label: const Text('Tentar novamente'),
+            ),
+          ],
+        ),
+      );
+    }
+
+    if (_branches.isEmpty) {
+      return Center(
+        child: Text(
+          'Nenhuma filial encontrada.\nContate o administrador.',
+          textAlign: TextAlign.center,
+          style: theme.textTheme.bodyMedium?.copyWith(
+            color: colors.onSurface.withOpacity(0.5),
+          ),
+        ),
+      );
+    }
+
+    return ListView.separated(
+      itemCount: _branches.length,
+      separatorBuilder: (_, __) => const SizedBox(height: 10),
+      itemBuilder: (context, index) {
+        final branch = _branches[index];
+        final isSelected = _selected?.id == branch.id;
+
+        return _BranchTile(
+          branch: branch,
+          isSelected: isSelected,
+          onTap: () => setState(() => _selected = branch),
+        );
+      },
+    );
+  }
+
+  Widget _buildConfirmButton(ColorScheme colors) {
+    return SizedBox(
+      width: double.infinity,
+      child: FilledButton(
+        onPressed: _selected != null && !_isConfirming ? _handleConfirm : null,
+        style: FilledButton.styleFrom(
+          padding: const EdgeInsets.symmetric(vertical: 16),
+          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
+        ),
+        child: _isConfirming
+            ? const SizedBox(
+                height: 20, width: 20,
+                child: CircularProgressIndicator(strokeWidth: 2, color: Colors.white),
+              )
+            : const Text('Entrar nesta filial', style: TextStyle(fontSize: 16, fontWeight: FontWeight.w700)),
+      ),
+    );
+  }
+}
+
+// ── Branch Tile ────────────────────────────────────────────────────────────────
+
+class _BranchTile extends StatelessWidget {
+  final BranchItem branch;
+  final bool isSelected;
+  final VoidCallback onTap;
+
+  const _BranchTile({
+    required this.branch,
+    required this.isSelected,
+    required this.onTap,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final colors = Theme.of(context).colorScheme;
+
+    return AnimatedContainer(
+      duration: const Duration(milliseconds: 180),
+      child: InkWell(
+        borderRadius: BorderRadius.circular(14),
+        onTap: onTap,
+        child: Container(
+          padding: const EdgeInsets.all(16),
+          decoration: BoxDecoration(
+            borderRadius: BorderRadius.circular(14),
+            border: Border.all(
+              color: isSelected ? colors.primary : colors.outline.withOpacity(0.4),
+              width: isSelected ? 2 : 1,
+            ),
+            color: isSelected
+                ? colors.primary.withOpacity(0.07)
+                : colors.surfaceVariant.withOpacity(0.35),
+          ),
+          child: Row(
+            children: [
+              // Radio indicator
+              Container(
+                width: 22,
+                height: 22,
+                decoration: BoxDecoration(
+                  shape: BoxShape.circle,
+                  border: Border.all(
+                    color: isSelected ? colors.primary : colors.outline,
+                    width: 2,
+                  ),
+                ),
+                child: isSelected
+                    ? Center(
+                        child: Container(
+                          width: 12,
+                          height: 12,
+                          decoration: BoxDecoration(
+                            shape: BoxShape.circle,
+                            color: colors.primary,
+                          ),
+                        ),
+                      )
+                    : null,
+              ),
+              const SizedBox(width: 14),
+
+              // Branch info
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Row(
+                      children: [
+                        Expanded(
+                          child: Text(
+                            branch.name,
+                            style: TextStyle(
+                              fontWeight: FontWeight.w700,
+                              fontSize: 15,
+                              color: isSelected ? colors.primary : colors.onSurface,
+                            ),
+                          ),
+                        ),
+                        if (branch.isDefault) ...[
+                          const SizedBox(width: 6),
+                          Container(
+                            padding: const EdgeInsets.symmetric(horizontal: 7, vertical: 2),
+                            decoration: BoxDecoration(
+                              color: Colors.amber.withOpacity(0.15),
+                              borderRadius: BorderRadius.circular(20),
+                              border: Border.all(color: Colors.amber.shade300, width: 1),
+                            ),
+                            child: const Text(
+                              'Padrão',
+                              style: TextStyle(
+                                fontSize: 10, fontWeight: FontWeight.w700,
+                                color: Colors.amber,
+                              ),
+                            ),
+                          ),
+                        ],
+                      ],
+                    ),
+                    if (branch.cnpj != null && branch.cnpj!.isNotEmpty) ...[
+                      const SizedBox(height: 3),
+                      Text(
+                        branch.cnpj!,
+                        style: TextStyle(
+                          fontSize: 12,
+                          color: colors.onSurface.withOpacity(0.55),
+                        ),
+                      ),
+                    ],
+                    const SizedBox(height: 3),
+                    Text(
+                      'ERP Empresa: ${branch.erpEmpresaId}',
+                      style: TextStyle(
+                        fontSize: 11,
+                        color: colors.onSurface.withOpacity(0.45),
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
