+        var branches = await branchRepo.GetByCompanyAsync(id, ct);
+        var dtos = branches.Select(b => new
+        {
+            id = b.Id,
+            name = b.Name,
+            cnpj = b.Cnpj,
+            erpEmpresaId = b.ErpEmpresaId,
+            erpDeptoPadrao = b.ErpDeptoPadrao,
+            erpCentroPadrao = b.ErpCentroPadrao,
+            isDefault = b.IsDefault
+        });
+        return Ok(dtos);
+    }
 }
