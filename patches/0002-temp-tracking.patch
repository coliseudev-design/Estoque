+namespace ColiseuSales.Worker.Config;
+
+/// <summary>
+/// Mapeia a seção "AutoCenterApi" do appsettings.json.
+/// Armazena credenciais e rotas para comunicação com o Middleware do AutoCenter.
+/// </summary>
+public class AutoCenterApiOptions
+{
+    public const string Section = "AutoCenterApi";
+
+    public string BaseUrl { get; set; } = string.Empty;
+    public string InternalApiKey { get; set; } = string.Empty;
+    public int TimeoutSeconds { get; set; } = 30;
+    public bool Enabled { get; set; } = false;
+}
diff --git a/worker/Jobs/SyncAutoCenterCatalogJob.cs b/worker/Jobs/SyncAutoCenterCatalogJob.cs
new file mode 100644
index 0000000..59905e3
--- /dev/null
+++ b/worker/Jobs/SyncAutoCenterCatalogJob.cs
@@ -0,0 +1,144 @@
+using System.Net.Http.Json;
+using System.Text.Json.Serialization;
+using ColiseuSales.Worker.Config;
+using ColiseuSales.Worker.Services;
+using Microsoft.Extensions.Options;
+
+namespace ColiseuSales.Worker.Jobs;
+
+/// <summary>
+/// Data Transfer Object para sincronizar Item do Catálogo pro AutoCenter
+/// </summary>
+public record AutoCenterCatalogDto(
+    [property: JsonPropertyName("erp_id")] int ErpId,
+    [property: JsonPropertyName("name")] string Name,
+    [property: JsonPropertyName("category")] string Category,
+    [property: JsonPropertyName("price")] double Price,
+    [property: JsonPropertyName("brand")] string? Brand, // MARCA
+    [property: JsonPropertyName("code")] string? Code, // CODIGO_BARRA ou REF
+    [property: JsonPropertyName("active")] bool Active
+);
+
+public sealed class SyncAutoCenterCatalogJob
+{
+    private readonly FirebirdService                       _firebird;
+    private readonly IHttpClientFactory                    _httpClientFactory;
+    private readonly ILogger<SyncAutoCenterCatalogJob>     _logger;
+    private readonly AutoCenterApiOptions                  _acOpts;
+    private readonly IdentityApiOptions                    _identityOpts;
+    private readonly StatusStore                           _status;
+
+    private readonly SemaphoreSlim _lock = new(1, 1);
+
+    public SyncAutoCenterCatalogJob(
+        FirebirdService firebird,
+        IHttpClientFactory httpClientFactory,
+        ILogger<SyncAutoCenterCatalogJob> logger,
+        IOptions<AutoCenterApiOptions> acOpts,
+        IOptions<IdentityApiOptions> identityOpts,
+        StatusStore status)
+    {
+        _firebird          = firebird;
+        _httpClientFactory = httpClientFactory;
+        _logger            = logger;
+        _acOpts            = acOpts.Value;
+        _identityOpts      = identityOpts.Value;
+        _status            = status;
+    }
+
+    /// <summary>
+    /// Sincroniza catálogo (produtos/serviços) do AutoCenter via API
+    /// </summary>
+    public async Task RunAsync(CancellationToken ct = default)
+    {
+        if (!_acOpts.Enabled) return;
+
+        if (!await _lock.WaitAsync(0, ct))
+        {
+            _logger.LogWarning("[SyncAutoCenterCatalog] Job já está em execução. Ignorando.");
+            return;
+        }
+
+        try
+        {
+            _logger.LogDebug("[SyncAutoCenterCatalog] Buscando Produtos/Serviços...");
+
+            var rows = await _firebird.QueryAsync(@"
+                SELECT
+                    P.ID_PRODUTO,
+                    P.DESCRICAO,
+                    COALESCE(C.DESCRICAO, 'Geral') AS CATEGORIA,
+                    P.MARCA,
+                    PP.PRECO_TABELA,
+                    P.CODIGO_BARRA,
+                    P.REF
+                FROM PRODUTOS P
+                INNER JOIN PRODUTO_PRECOS PP ON PP.ID_PRODUTO = P.ID_PRODUTO
+                LEFT JOIN CATEGORIAS C ON C.ID_CATEGORIA = P.ID_CATEGORIA
+                WHERE COALESCE(P.BLOQUEADO, 0) = 0
+                  AND PP.ATIVO = 1
+                ORDER BY P.DESCRICAO", ct: ct);
+
+            if (rows.Count == 0)
+            {
+                _logger.LogWarning("[SyncAutoCenterCatalog] Nenhum produto ativo encontrado no ERP.");
+                _status.Update("AutoCenter_Catalog", 0, DateTime.Now, "Sem dados no Firebird");
+                return;
+            }
+
+            var catalogList = rows.Select(row => new AutoCenterCatalogDto(
+                ErpId: Convert.ToInt32(row["ID_PRODUTO"]),
+                Name: row["DESCRICAO"]?.ToString()?.Trim() ?? "Sem Nome",
+                Category: row["CATEGORIA"]?.ToString()?.Trim() ?? "Geral",
+                Price: row["PRECO_TABELA"] != null ? Convert.ToDouble(row["PRECO_TABELA"]) : 0.0,
+                Brand: row["MARCA"]?.ToString()?.Trim(),
+                Code: (row["CODIGO_BARRA"]?.ToString()?.Trim()) ?? (row["REF"]?.ToString()?.Trim()),
+                Active: true
+            )).ToList();
+
+            _logger.LogInformation("[SyncAutoCenterCatalog] Sincronizando {Count} itens para Middleware...", catalogList.Count);
+
+            await PushToMiddlewareAsync(catalogList, ct);
+
+            _status.Update("AutoCenter_Catalog", catalogList.Count, DateTime.Now);
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError("[SyncAutoCenterCatalog] Erro: {Error}", ex.Message);
+            _status.Update("AutoCenter_Catalog", 0, DateTime.Now, ex.Message);
+        }
+        finally
+        {
+            _lock.Release();
+        }
+    }
+
+    private async Task PushToMiddlewareAsync(List<AutoCenterCatalogDto> catalog, CancellationToken ct)
+    {
+        var client    = _httpClientFactory.CreateClient("AutoCenterApiClient");
+        var tenantId  = _identityOpts.TenantId.ToString();
+
+        if (!client.DefaultRequestHeaders.Contains("X-Tenant-Id"))
+            client.DefaultRequestHeaders.Add("X-Tenant-Id", tenantId);
+
+        const int batchSize  = 500;
+        int       totalBatch = (int)Math.Ceiling(catalog.Count / (double)batchSize);
+
+        for (int i = 0; i < totalBatch; i++)
+        {
+            var batch = catalog.Skip(i * batchSize).Take(batchSize).ToList();
+
+            var response = await client.PostAsJsonAsync("/internal/catalog/sync", batch, ct);
+
+            if (response.IsSuccessStatusCode)
+            {
+                _logger.LogInformation("[SyncAutoCenterCatalog] Batch {Batch}/{TotalBatch} enviado com sucesso.", i + 1, totalBatch);
+            }
+            else
+            {
+                var error = await response.Content.ReadAsStringAsync(ct);
+                _logger.LogError("[SyncAutoCenterCatalog] Falha post batch {Batch}. Status={Status}, Erro={Error}", i + 1, response.StatusCode, error);
+            }
+        }
+    }
+}
diff --git a/worker/Jobs/SyncAutoCenterCustomersJob.cs b/worker/Jobs/SyncAutoCenterCustomersJob.cs
new file mode 100644
index 0000000..b36162e
--- /dev/null
+++ b/worker/Jobs/SyncAutoCenterCustomersJob.cs
@@ -0,0 +1,173 @@
+using System.Net.Http.Json;
+using System.Text.Json.Serialization;
+using ColiseuSales.Worker.Config;
+using ColiseuSales.Worker.Services;
+using Microsoft.Extensions.Options;
+
+namespace ColiseuSales.Worker.Jobs;
+
+/// <summary>
+/// DTO de cliente enviado ao middleware AutoCenter.
+/// Estrutura offline-friendly — o app mobile persiste localmente no SQLite.
+/// </summary>
+public record AutoCenterCustomerDto(
+    [property: JsonPropertyName("erpId")]       int    ErpId,
+    [property: JsonPropertyName("name")]        string Name,
+    [property: JsonPropertyName("fantasyName")] string FantasyName,
+    [property: JsonPropertyName("cpfCnpj")]     string CpfCnpj,
+    [property: JsonPropertyName("phone")]       string Phone,
+    [property: JsonPropertyName("phone2")]      string Phone2,
+    [property: JsonPropertyName("email")]       string Email,
+    [property: JsonPropertyName("city")]        string City,
+    [property: JsonPropertyName("address")]     string Address,
+    [property: JsonPropertyName("active")]      bool   Active
+);
+
+/// <summary>
+/// SyncAutoCenterCustomersJob — Lê clientes do Firebird e envia ao middleware AutoCenter.
+///
+/// Comportamento offline-first (mesmo padrão Coliseu Sales):
+///   1. Lê clientes ativos do Firebird via QueryAsync
+///   2. POST /api/customers/sync no middleware AutoCenter
+///   3. Middleware persiste → app faz download → SQLite local
+///   4. App funciona offline até próxima sincronização
+/// </summary>
+public sealed class SyncAutoCenterCustomersJob
+{
+    private readonly FirebirdService                       _firebird;
+    private readonly IHttpClientFactory                    _httpClientFactory;
+    private readonly ILogger<SyncAutoCenterCustomersJob>   _logger;
+    private readonly AutoCenterApiOptions                  _acOpts;
+    private readonly IdentityApiOptions                    _identityOpts;
+    private readonly StatusStore                           _status;
+
+    private readonly SemaphoreSlim _lock = new(1, 1);
+
+    public SyncAutoCenterCustomersJob(
+        FirebirdService firebird,
+        IHttpClientFactory httpClientFactory,
+        ILogger<SyncAutoCenterCustomersJob> logger,
+        IOptions<AutoCenterApiOptions> acOpts,
+        IOptions<IdentityApiOptions> identityOpts,
+        StatusStore status)
+    {
+        _firebird          = firebird;
+        _httpClientFactory = httpClientFactory;
+        _logger            = logger;
+        _acOpts            = acOpts.Value;
+        _identityOpts     = identityOpts.Value;
+        _status            = status;
+    }
+
+    public async Task RunAsync(CancellationToken ct = default)
+    {
+        if (!_acOpts.Enabled) return;
+
+        if (!await _lock.WaitAsync(0, ct)) return;
+
+        try
+        {
+            var customers = await ReadCustomersFromFirebirdAsync(ct);
+
+            if (customers.Count == 0)
+            {
+                _logger.LogInformation("[AutoCenterCustomers] Nenhum cliente ativo no Firebird.");
+                return;
+            }
+
+            await PushToMiddlewareAsync(customers, ct);
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError(ex, "[AutoCenterCustomers] Falha na sincronização de clientes.");
+            _status.AppendLog($"[{DateTime.Now:HH:mm:ss}] ✗ [AutoCenter-Clientes] {ex.Message}");
+        }
+        finally
+        {
+            _lock.Release();
+        }
+    }
+
+    // ─────────────────────────────────────────────────────────────────────────
+    // Leitura do Firebird — usa QueryAsync (padrão do projeto)
+    // ─────────────────────────────────────────────────────────────────────────
+
+    private async Task<List<AutoCenterCustomerDto>> ReadCustomersFromFirebirdAsync(CancellationToken ct)
+    {
+        const string sql = @"
+            SELECT FIRST 5000
+                c.IDCLIENTE,
+                COALESCE(c.RAZAO, '')    AS RAZAO,
+                COALESCE(c.FANTASIA, '') AS FANTASIA,
+                COALESCE(c.CPFCGC, '')  AS CPFCGC,
+                COALESCE(c.FONE, '')    AS FONE,
+                COALESCE(c.FONE2, '')   AS FONE2,
+                COALESCE(c.EMAIL, '')   AS EMAIL,
+                COALESCE(c.CIDADE, '')  AS CIDADE,
+                COALESCE(c.ENDERECO, '') AS ENDERECO,
+                c.ATIVO
+            FROM CLIENTES c
+            WHERE c.ATIVO = 'S'
+            ORDER BY c.IDCLIENTE";
+
+        var rows = await _firebird.QueryAsync(sql, ct: ct);
+
+        var customers = rows.Select(row => new AutoCenterCustomerDto(
+            ErpId:       Convert.ToInt32(row["IDCLIENTE"]  ?? 0),
+            Name:        row["RAZAO"]?.ToString()?.Trim()    ?? "",
+            FantasyName: row["FANTASIA"]?.ToString()?.Trim() ?? "",
+            CpfCnpj:     row["CPFCGC"]?.ToString()?.Trim()  ?? "",
+            Phone:       row["FONE"]?.ToString()?.Trim()     ?? "",
+            Phone2:      row["FONE2"]?.ToString()?.Trim()    ?? "",
+            Email:       row["EMAIL"]?.ToString()?.Trim()    ?? "",
+            City:        row["CIDADE"]?.ToString()?.Trim()   ?? "",
+            Address:     row["ENDERECO"]?.ToString()?.Trim() ?? "",
+            Active:      row["ATIVO"]?.ToString()?.Trim().Equals("S", StringComparison.OrdinalIgnoreCase) == true
+        )).ToList();
+
+        _logger.LogInformation("[AutoCenterCustomers] {Count} clientes lidos do Firebird.", customers.Count);
+        return customers;
+    }
+
+    // ─────────────────────────────────────────────────────────────────────────
+    // Envio ao middleware — lotes de 500
+    // ─────────────────────────────────────────────────────────────────────────
+
+    private async Task PushToMiddlewareAsync(List<AutoCenterCustomerDto> customers, CancellationToken ct)
+    {
+        var client    = _httpClientFactory.CreateClient("AutoCenterApiClient");
+        var tenantId  = _identityOpts.TenantId.ToString();
+
+        // Worker envia X-Tenant-Id para que o middleware saiba a qual empresa pertencem os clientes
+        if (!client.DefaultRequestHeaders.Contains("X-Tenant-Id"))
+            client.DefaultRequestHeaders.Add("X-Tenant-Id", tenantId);
+
+        const int batchSize  = 500;
+        int       totalBatch = (int)Math.Ceiling(customers.Count / (double)batchSize);
+
+        for (int i = 0; i < totalBatch; i++)
+        {
+            var batch = customers.Skip(i * batchSize).Take(batchSize).ToList();
+
+            // Rota interna do middleware — autenticada via X-Internal-Key (já no DefaultRequestHeaders)
+            var response = await client.PostAsJsonAsync("/internal/customers/sync", batch, ct);
+
+            if (response.IsSuccessStatusCode)
+            {
+                _logger.LogInformation(
+                    "[AutoCenterCustomers] Lote {N}/{T} enviado ({C} clientes).",
+                    i + 1, totalBatch, batch.Count);
+            }
+            else
+            {
+                var body = await response.Content.ReadAsStringAsync(ct);
+                _logger.LogWarning(
+                    "[AutoCenterCustomers] Lote {N} falhou: HTTP {S} — {B}",
+                    i + 1, (int)response.StatusCode, body[..Math.Min(200, body.Length)]);
+            }
+        }
+
+        _status.AppendLog(
+            $"[{DateTime.Now:HH:mm:ss}] 👥 [AutoCenter] {customers.Count} clientes → middleware");
+    }
+}
