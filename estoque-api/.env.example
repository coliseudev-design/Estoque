# ── Coliseu Estoque API ──────────────────────────────────────────────────────
PORT=3100
NODE_ENV=development

# PostgreSQL (banco próprio do Estoque — não é o banco do Identity)
DATABASE_URL=postgres://postgres:dev_password@localhost:5432/coliseu_estoque
PG_SSL=false

# Coliseu.Identity (painel de licenças)
IDENTITY_BASE_URL=https://adminlicencas.coliseusistemas.com.br
# Mesmo valor configurado em InternalApiKey no Identity (header X-Internal-Api-Key)
IDENTITY_INTERNAL_API_KEY=
# Slug do módulo "Estoque Coliseu" no painel. Confira em Empresas > Módulos & APIs.
ESTOQUE_MODULE_SLUG=estoque
LICENSE_CACHE_TTL_SECONDS=300
LICENSE_GRACE_HOURS=24

# Segredo dos tokens de usuário emitidos por esta API (gere: openssl rand -base64 48)
ESTOQUE_JWT_SECRET=
ESTOQUE_JWT_TTL=12h
# Mesmo Jwt:DeviceSigningKey do Identity — valida o JWT de dispositivo do app
JWT_ACCESS_SECRET=

# Origens extras autorizadas (só se o dashboard for servido em outro domínio)
ALLOWED_ORIGINS=
LOG_LEVEL=info
