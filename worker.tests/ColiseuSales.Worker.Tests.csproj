<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows: necessário para referenciar o Worker que usa APIs Windows-specific -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ColiseuSales.Worker.Tests</RootNamespace>
    <AssemblyName>ColiseuSales.Worker.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit 2 + runner -->
    <PackageReference Include="xunit"                        Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio"    Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk"       Version="17.11.1" />
    <!-- Mocking -->
    <PackageReference Include="Moq"                          Version="4.20.72" />
    <!-- FluentAssertions para legibilidade -->
    <PackageReference Include="FluentAssertions"             Version="6.12.1" />
    <!-- Microsoft.Extensions para ILogger mock -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!-- Referência ao Shared (DTOs) -->
  <ItemGroup>
    <ProjectReference Include="..\shared\ColiseuSales.Shared.csproj" />
  </ItemGroup>

  <!-- Referência ao Worker (inclui Config.FirebirdOptions usado em FirebirdOptionsTests) -->
  <ItemGroup>
    <ProjectReference Include="..\worker\ColiseuSales.Worker.csproj" />
  </ItemGroup>

</Project>
