# ================================================
# ColiseSpeed — Variáveis de Ambiente (Produção)
# ================================================
# Configure no Coolify UI → Environment Variables
# Domínio: speed.coliseusistemas.com.br
# ================================================

# === PostgreSQL (Coolify Postgres Central) ===
PG_HOST=<container-name-postgres-coolify>
PG_PORT=5432
PG_DATABASE=coliseuspeed
PG_USER=<usuario>
PG_PASSWORD=<senha>
PG_SSL=false

# === Redis (Coolify Redis Central) ===
REDIS_HOST=<container-name-redis-coolify>
REDIS_PORT=6379
REDIS_PASSWORD=<senha-redis>
REDIS_URL=

# === Authentication ===
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=<sha256-hash-da-api-key>
ADMIN_API_KEY=<chave-admin>
JWT_ACCESS_SECRET=<secret-jwt-igual-identity>

# === Identity API ===
IDENTITY_BASE_URL=https://adminlicencas.coliseusistemas.com.br
INTERNAL_API_KEY=<chave-interna-identity>

# === Company Seed ===
COMPANY_NAME=<nome-empresa>
COMPANY_ID=<uuid-empresa>

# === Firebird (Worker mode) ===
FB_MOCK=true
SYNC_MODE=async

# === CORS ===
ALLOWED_ORIGINS=https://speed.coliseusistemas.com.br,https://adminlicencas.coliseusistemas.com.br

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
