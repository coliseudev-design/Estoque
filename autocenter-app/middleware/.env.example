# =============================================================================
# .env.example — AutoCenter :: Middleware
#
# Copie para .env e preencha os valores antes de iniciar o serviço.
# NUNCA commite o .env real no repositório.
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=3100

# ── JWT (MESMO segredo do Coliseu Identity Server) ────────────────────────────
# Este middleware valida SOMENTE JWTs emitidos pelo Identity Server.
# Deve ser igual à variável JWT_DEVICE_KEY no Identity Server.
JWT_DEVICE_KEY=CONFIGURE_AQUI_O_MESMO_SEGREDO_DO_IDENTITY

# Módulo esperado no claim JWT (protege contra tokens válidos de outros módulos)
EXPECTED_MODULE_SLUG=autocenter

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Pode compartilhar o mesmo banco do Identity (coliseu_identity)
# ou ter um banco separado (autocenter_db). Recomendado: banco separado.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=autocenter_db
PG_USER=coliseu_admin
PG_PASSWORD=troque-em-producao
PG_SSL=false                  # true em produção

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=                   # IP/host explícito. Vazio = usa REDIS_URL
REDIS_PORT=6379
REDIS_PASSWORD=               # Vazio = sem autenticação
REDIS_URL=redis://localhost:6379

# Tempo de cache de consulta de placa (segundos)
VEHICLE_CACHE_TTL_SECONDS=86400   # 24 horas

# ── APIBrasil — Consulta de Placa ─────────────────────────────────────────────
# Obtenha em: https://apibrasil.com.br
APIBRASIL_TOKEN=SEU_TOKEN_AQUI
APIBRASIL_DEVICE_TOKEN=SEU_DEVICE_TOKEN_AQUI

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://autocenter.coliseusistemas.com.br

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
