{
  "name": "coliseu-sales-middleware",
  "version": "1.1.1",
  "description": "Middleware de sincronização entre app mobile e ERP Firebird — Coliseu Sales Force",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test tests/*.test.js",
    "test:jest": "jest --testPathPattern=integration --forceExit",
    "test:watch": "jest --watch",
    "lint": "node --check src/index.js src/routes/*.js src/services/*.js src/middleware/*.js src/config/*.js",
    "check": "node -e \"require('./src/config/env')\" && echo '✓ Env OK'"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "axios": "^1.15.1",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "node-firebird": "^1.1.8",
    "pg": "^8.19.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathPattern": "tests/",
    "clearMocks": true,
    "testTimeout": 10000
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
