# =============================================================================
# .env.example — Coliseu Sales :: Middleware
#
# Copie para .env e preencha os valores antes de iniciar o serviço.
# NUNCA commite o .env real no repositório.
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=3000

# ── Autenticação ──────────────────────────────────────────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=2bb4e34436aa52baa1c5937a01a7eb872f4a8046790418294089b23dc6c5928e
ADMIN_API_KEY=troque-por-outra-chave-segura
# Nome da empresa exibido no painel — obrigatório para o seed inicial no PG
COMPANY_NAME=Coliseu Piveta
# UUID fixo da empresa — mantenha o mesmo valor entre deploys para idempotência do seed
# Gerar: node -e "console.log(require('crypto').randomUUID())"
COMPANY_ID=CONFIGURE_AQUI_UUID_DA_EMPRESA

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=coliseu_identity  # Gerenciado pela Coliseu.Identity API
PG_USER=coliseu_admin
PG_PASSWORD=troque-em-producao
PG_SSL=false                  # true em produção

# ── Redis ─────────────────────────────────────────────────────────────────────
# REDIS_HOST tem prioridade sobre REDIS_URL (contorna auto-inject do Coolify).
# Em produção Coolify: defina REDIS_HOST com o IP do container Redis correto.
# Sem senha (dev local): deixe REDIS_HOST e REDIS_PASSWORD em branco, use REDIS_URL.
REDIS_HOST=                           # IP/host explícito (ex: 10.0.8.4). Vazio = usa REDIS_URL
REDIS_PORT=6379
REDIS_PASSWORD=                       # Senha do Redis (vazio = sem autenticação)
REDIS_URL=redis://localhost:6379      # Fallback se REDIS_HOST não definido

# ── Firebird ERP ──────────────────────────────────────────────────────────────
FB_MOCK=false
FB_HOST=localhost
FB_PORT=3050
FB_DATABASE=C:/Coliseu/Data/PIVETA.FDB
FB_USER=SYSDBA
FB_PASSWORD=SUBSTITUA_PELA_SENHA_DO_FIREBIRD

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://admin.coliseusales.com.br

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
