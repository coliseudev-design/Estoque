# ── SEGREDOS — NÃO COMMITAR! ─────────────────────────────────────────────────
# Copie este arquivo para .env e configure os valores antes de executar docker-compose.

# PostgreSQL
POSTGRES_PASSWORD=CONFIGURE_UMA_SENHA_FORTE_AQUI

# Redis
REDIS_PASSWORD=CONFIGURE_UMA_SENHA_FORTE_AQUI

# JWT Signing Keys (mínimo 32 caracteres cada)
JWT_DEVICE_KEY=CONFIGURE_AQUI_MIN_32_CHARS_DEVICE_KEY
JWT_ADMIN_KEY=CONFIGURE_AQUI_MIN_32_CHARS_ADMIN_KEY

# Encryption (AES-256): gere com: openssl rand -base64 32
ENCRYPTION_KEY=CONFIGURE_AQUI_BASE64_32BYTES

# Sales API
SALES_API_BASE_URL=https://api.dominio.com

# Internal API Key (usada pelo middleware para chamar rotas internas do Identity)
INTERNAL_API_KEY=CONFIGURE_AQUI_MIN_32_CHARS_INTERNAL_KEY

# Senha inicial do SuperAdmin (usada pelo DbInitializer na PRIMEIRA execução).
# OBRIGATÓRIO: sem esta variável o serviço crasha ao iniciar!
# Requisitos: mínimo 8 chars, 1 maiúscula, 1 minúscula, 1 número.
# Troque esta senha imediatamente após o primeiro login no painel Admin.
SEED_ADMIN_PASSWORD=ColiseuAdmin@2025

# UAZAPI WhatsApp Integration
UAZAPI_SERVER_URL=https://api.uazapi.com.br
UAZAPI_TOKEN=CONFIGURE_SEU_TOKEN_AQUI
UAZAPI_ENABLED=true
UAZAPI_ADMIN_PHONE=5567999998888
