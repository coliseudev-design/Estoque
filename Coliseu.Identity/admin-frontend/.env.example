# Variáveis de ambiente do painel Admin Coliseu Identity
# Copie este arquivo para .env e configure os valores

# URL base da Identity API (backend .NET - onde o painel faz login)
VITE_API_URL=https://localhost:7001/admin

# URL base do Sales API (para o card de monitoramento em CompanyDetails)
# O Sales API roda na porta 5000 por padrão
VITE_SALES_API_URL=https://localhost:5000

# API Key do Sales API (mesma configurada no Worker Service)
# Necessária para acessar o endpoint de monitoramento
VITE_SALES_API_KEY=CONFIGURE_COM_A_MESMA_CHAVE_DO_WORKER
