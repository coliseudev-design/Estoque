@page "/audit"
@attribute [Authorize]
@inject IdentityApiService Api

<PageTitle>Auditoria | Coliseu Identity</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Logs de Auditoria</h1>
        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadLogs">
            <i class="bi bi-arrow-clockwise"></i> Atualizar
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Data/Hora</th>
                            <th>Ação</th>
                            <th>Entidade</th>
                            <th>Detalhes</th>
                            <th class="pe-4">IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="spinner-border text-primary"></div>
                                </td>
                            </tr>
                        }
                        else if (!_logs.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">Nenhum log de auditoria encontrado.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in _logs)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <small class="text-secondary">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                                        <div class="fw-bold">@log.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</div>
                                    </td>
                                    <td>
                                        <span class="badge @GetActionClass(log.Action)">
                                            @log.Action
                                        </span>
                                    </td>
                                    <td>
                                        @if (log.CompanyId.HasValue)
                                        {
                                            <div class="small">Empresa: <span class="badge bg-light text-dark border">@log.CompanyId</span></div>
                                        }
                                        @if (log.DeviceId.HasValue)
                                        {
                                            <div class="small">Dispositivo: <span class="badge bg-light text-dark border">@log.DeviceId</span></div>
                                        }
                                    </td>
                                    <td style="max-width: 300px;">
                                        <div class="text-truncate small" title="@log.Details">
                                            @log.Details
                                        </div>
                                    </td>
                                    <td class="pe-4">
                                        <code class="small">@log.IpAddress</code>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (_totalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3">
                <nav>
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(_currentPage - 1)">Anterior</button>
                        </li>
                        @for (int i = 1; i <= _totalPages; i++)
                        {
                            var p = i;
                            <li class="page-item @(_currentPage == p ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(p)">@p</button>
                            </li>
                        }
                        <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(_currentPage + 1)">Próximo</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@code {
    private List<AuditLogDto> _logs = new();
    private bool _loading = true;
    private int _currentPage = 1;
    private int _totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        _loading = true;
        var result = await Api.GetAuditLogsAsync(_currentPage);
        if (result.IsSuccess)
        {
            _logs = result.Value!.Items.ToList();
            _totalPages = result.Value.TotalPages;
        }
        _loading = false;
    }

    private async Task ChangePage(int newPage)
    {
        _currentPage = newPage;
        await LoadLogs();
    }

    private string GetActionClass(string action) => action.ToLower() switch
    {
        var a when a.Contains("login") => "bg-info text-dark",
        var a when a.Contains("block") || a.Contains("suspend") => "bg-danger",
        var a when a.Contains("create") || a.Contains("update") => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
