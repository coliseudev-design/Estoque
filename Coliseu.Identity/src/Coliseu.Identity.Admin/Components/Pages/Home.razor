@page "/"
@attribute [Authorize]
@inject IdentityApiService Api

<PageTitle>Dashboard | Coliseu Identity</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-4">Dashboard</h1>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                        <i class="bi bi-building text-primary fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-secondary mb-1">Empresas</h6>
                        <h3 class="mb-0">@(_companiesTotal >= 0 ? _companiesTotal : "...")</h3>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                        <i class="bi bi-phone text-success fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-secondary mb-1">Dispositivos Ativos</h6>
                        <h3 class="mb-0">...</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                        <i class="bi bi-shield-lock text-warning fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-secondary mb-1">Logs de Segurança</h6>
                        <h3 class="mb-0">...</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <h4>Ações Rápidas</h4>
        <div class="d-flex gap-3">
            <a href="/companies" class="btn btn-outline-primary d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i> Gerenciar Empresas
            </a>
            <a href="/audit" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-list-check"></i> Auditoria
            </a>
        </div>
    </div>
</div>

@code {
    private int _companiesTotal = -1;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetCompaniesAsync(1, 1);
        if (result.IsSuccess)
        {
            _companiesTotal = result.Value!.TotalCount;
        }
    }
}
